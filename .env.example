# Kopieren nach .env und anpassen. Nicht ins Git einchecken.
ADMIN_USER=admin
ADMIN_PASSWORT=hier-ein-langes-passwort

# Öffentliche Adresse, unter der die Seite erreichbar ist (für Links in Feed, Kalender und Benachrichtigungen)
OEFFENTLICHE_URL=https://kalender.example.org
UID_DOMAIN=kalender.example.org
SEITENTITEL=TCG-Release-Kalender

# Optional: automatische Recherche mit Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CHECK_INTERVALL_TAGE=7
CHECK_STUNDE=6
CLAUDE_MAX_SUCHEN_PRO_SPIEL=6

# Optional: Benachrichtigungen bei Änderungen
DISCORD_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_SPIELE=
WEBHOOK_ARTEN=neu,verschoben,geaendert,geloescht
